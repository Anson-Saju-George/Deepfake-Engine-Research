% --- The closest prior work. Validates whole-frame; defines what is left open.
@inproceedings{kundu2025unite,                    % [CORE — Tier 1]
  title     = {Towards a Universal Synthetic Video Detector: From Face or Background
               Manipulations to Fully {AI}-Generated Content},
  author    = {Kundu, Rohit and Xiong, Hao and Mohanty, Vishal and
               Balachandran, Athula and Roy-Chowdhury, Amit K.},
  booktitle = {Proc. IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)},
  pages     = {28050--28060},
  year      = {2025},
  note      = {UNITE. arXiv:2412.12278. Whole-frame, SigLIP-So400M features,
               attention-diversity loss, 384x384 input. Trains FF++ only vs FF++ + GTA-V
               (SAIL-VOS-3D game footage, NOT AI T2V). Key numbers: FF++ 99.96,
               CelebDF 95.11, DeeperForensics 99.62, UADFV 97.01. Critically:
               FF++ -> DeMamba 57.38 AUC, FF++ + GTA-V -> DeMamba 93.75 AUC.
               NOT trained on the GenVideo train split.}
}

