@misc{cakiroglu2026vidaudit,                   % [CORE — Tier 1]
  title   = {Auditing Generalization in {AI}-Generated Video Detection: A Six-Control
             Protocol and the {VidAudit} Toolkit},
  author  = {Cakiroglu, Mert Onur and Lu, Zhihe and Dalkilic, Mehmet and Kurban, Hasan},
  eprint       = {2606.31004},
  archivePrefix= {arXiv},
  primaryClass = {cs.CV},
  year    = {2026},
  note    = {Indiana University Bloomington; Hamad Bin Khalifa University.
             A three-feature CLIP-LENGTH classifier reaches LOGO AUC 0.998 on GenVidBench
             unaudited, collapsing to 0.529 (chance) under audit. A 20-paper survey found
             NONE applying all six controls. A CLIP baseline was caught carrying dataset
             identity. METRICS: at FPR 0.1% multiple high-AUC methods fall to single-digit
             recall and leaderboard order changes -- they recommend an audited TUPLE
             (AUC, above-floor margin, operating-point recall, calibration) over a single
             number. 14 detectors behind one plugin API.}
}

